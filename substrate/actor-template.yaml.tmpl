# ActorTemplate is an Agent Substrate API resource, not a Kubernetes CRD.
# Apply with `kubectl ate create actor-template -f -`.
metadata:
  atespace: n8n-sandboxes
  name: n8n-sandbox
workerSelector:
  matchLabels:
    workload: n8n-sandbox
containers:
- name: sandbox
  # The control plane rejects images without a digest.
  image: ${SUBSTRATE_SANDBOX_IMAGE}
  command:
  - /usr/local/bin/sandbox-daemon
  args:
  - --listen-addr
  - :80
  wakeupProbe:
    httpGet:
      path: /healthz
      port: 80
    timeoutSeconds: 30
  securityContext:
    capabilities:
      drop:
      - ALL
      add:
      - NET_BIND_SERVICE
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
