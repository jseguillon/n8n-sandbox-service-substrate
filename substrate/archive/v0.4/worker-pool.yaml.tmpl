# Archived WorkerPool for Substrate v0.4.
apiVersion: v1
kind: Namespace
metadata:
  name: n8n-sandboxes
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: n8n-sandbox
  namespace: n8n-sandboxes
  labels:
    workload: n8n-sandbox
spec:
  replicas: 1
  sandboxClass: gvisor
  # Build this image from the same Substrate v0.4.0 source as the control plane.
  # The default kind install prints the digest with `ate-setup publish worker-images`.
  workerImage: ${SUBSTRATE_WORKER_IMAGE}
  template:
    resources:
      limits:
        cpu: "4"
        memory: 8Gi
      requests:
        cpu: "1"
        memory: 8Gi
